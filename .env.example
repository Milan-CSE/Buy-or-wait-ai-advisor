# Buy or Wait? Production Environment Configuration Example
# Copy to .env and configure real credentials. NEVER commit .env to version control!

# Environment Profile: development | testing | production
ENVIRONMENT=development

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql://buyorwait_app:change_this_strong_password@localhost:5432/buyorwait_db
POSTGRES_USER=buyorwait_app
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=buyorwait_db
POSTGRES_PORT=5432

# Security & JWT Configuration
# In production, must be at least 32 cryptographically secure random bytes
JWT_SECRET_KEY=replace_with_at_least_32_random_bytes_generated_via_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
TOKEN_ISSUER=buyorwait
TOKEN_AUDIENCE=buyorwait_api

# Rate Limiting (Requests per 60-second window)
RATE_LIMIT_AUTH=5
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_EVALUATE=30
RATE_LIMIT_GENERAL=120

# CORS Allowed Origins (comma-separated, NO WILDCARDS in production)
CORS_ORIGINS=https://app.buyorwait.com,https://dashboard.buyorwait.com

# Engine Versions
CALIBRATION_VERSION=v3_empirical_q90_20260914
